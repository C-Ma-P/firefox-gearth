{
  "manifest_version": 3,
  "name": "Open in Google Earth",
  "version": "0.2.0",
  "description": "Open selected coordinates, addresses, or place names directly in Google Earth.",
  "permissions": [
    "contextMenus",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{4d22bb6b-6b2a-4f4d-a4fd-a92320e0c2d1}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/google-earth.svg",
    "32": "icons/google-earth.svg",
    "48": "icons/google-earth.svg",
    "96": "icons/google-earth.svg"
  }
}
